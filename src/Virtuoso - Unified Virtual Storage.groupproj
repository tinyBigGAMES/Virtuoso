<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{285C5AE5-AFE1-469F-9E5D-A04E9C775186}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="..\testbed\Testbed.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="..\examples\RaylibVPKDemo\RaylibVPKDemo.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="Testbed">
        <MSBuild Projects="..\testbed\Testbed.dproj"/>
    </Target>
    <Target Name="Testbed:Clean">
        <MSBuild Projects="..\testbed\Testbed.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Testbed:Make">
        <MSBuild Projects="..\testbed\Testbed.dproj" Targets="Make"/>
    </Target>
    <Target Name="RaylibVPKDemo">
        <MSBuild Projects="..\examples\RaylibVPKDemo\RaylibVPKDemo.dproj"/>
    </Target>
    <Target Name="RaylibVPKDemo:Clean">
        <MSBuild Projects="..\examples\RaylibVPKDemo\RaylibVPKDemo.dproj" Targets="Clean"/>
    </Target>
    <Target Name="RaylibVPKDemo:Make">
        <MSBuild Projects="..\examples\RaylibVPKDemo\RaylibVPKDemo.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="Testbed;RaylibVPKDemo"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="Testbed:Clean;RaylibVPKDemo:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="Testbed:Make;RaylibVPKDemo:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
